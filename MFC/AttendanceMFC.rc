#pragma code_page(65001)

#include "resource.h"
#include "afxres.h"

IDD_ATTENDANCE_DIALOG DIALOGEX 0, 0, 620, 420
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "大学生考勤系统（MFC 版本 · 甲数据层 + 乙统计 + 丙界面）"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    /* ---------- 一、录入区 ---------- */
    GROUPBOX        "考勤记录录入（选中列表中的一行后可直接修改）",IDC_STATIC,10,6,600,88

    LTEXT           "学号",IDC_STATIC,20,24,26,10
    EDITTEXT        IDC_EDIT_ID,48,21,90,14,ES_AUTOHSCROLL
    LTEXT           "姓名",IDC_STATIC,148,24,26,10
    EDITTEXT        IDC_EDIT_NAME,176,21,80,14,ES_AUTOHSCROLL
    LTEXT           "班级",IDC_STATIC,266,24,26,10
    EDITTEXT        IDC_EDIT_CLASS,294,21,110,14,ES_AUTOHSCROLL

    LTEXT           "月",IDC_STATIC,20,50,20,10
    EDITTEXT        IDC_EDIT_MONTH,48,47,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "日",IDC_STATIC,98,50,20,10
    EDITTEXT        IDC_EDIT_DAY,122,47,40,14,ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "状态",IDC_STATIC,176,50,26,10
    COMBOBOX        IDC_COMBO_STATUS,206,47,90,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    PUSHBUTTON      "添加记录",IDC_BTN_ADD,414,20,64,16
    PUSHBUTTON      "修改选中",IDC_BTN_UPDATE,484,20,64,16
    PUSHBUTTON      "删除选中",IDC_BTN_DELETE,554,20,50,16
    PUSHBUTTON      "清空输入",IDC_BTN_CLEAR,414,46,64,16
    LTEXT           "先选中一行，再点修改 / 删除",IDC_STATIC_HINT,484,49,124,10

    /* ---------- 二、查找与分页 ---------- */
    GROUPBOX        "查找与分页",IDC_STATIC_GROUP,10,100,600,44
    LTEXT           "查找",IDC_STATIC,20,118,26,10
    EDITTEXT        IDC_EDIT_KEY,48,115,90,14,ES_AUTOHSCROLL
    COMBOBOX        IDC_COMBO_FIND,144,115,70,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "查找",IDC_BTN_FIND,220,114,50,16
    PUSHBUTTON      "显示全部",IDC_BTN_SHOWALL,276,114,58,16
    LTEXT           "排序",IDC_STATIC,344,118,26,10
    COMBOBOX        IDC_COMBO_SORT,372,115,96,110,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "上一页",IDC_BTN_PREV,478,114,44,16
    PUSHBUTTON      "下一页",IDC_BTN_NEXT,526,114,44,16
    LTEXT           "",IDC_STATIC_PAGE,576,118,30,10

    /* ---------- 三、记录列表 ---------- */
    CONTROL         "",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP,10,150,600,140

    /* ---------- 四、报表区 ---------- */
    LTEXT           "报表",IDC_STATIC,10,298,26,10
    COMBOBOX        IDC_COMBO_REPORT,38,295,110,130,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "生成报表",IDC_BTN_REPORT,154,294,60,16
    LTEXT           "报表输出（乙模块 sort_report.cpp 的结果）",IDC_STATIC,224,298,200,10
    EDITTEXT        IDC_EDIT_REPORT,10,312,600,66,ES_MULTILINE | ES_READONLY | WS_BORDER | WS_VSCROLL

    /* ---------- 五、状态与退出 ---------- */
    LTEXT           "",IDC_STATIC_COUNT,10,388,200,12
    PUSHBUTTON      "保存到文件",IDC_BTN_SAVE,430,384,68,18
    PUSHBUTTON      "从文件读取",IDC_BTN_LOAD,504,384,68,18
    PUSHBUTTON      "退出",IDC_BTN_EXIT,578,384,32,18
END
